  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Shop owner profile document"
    },
    "/users/{userId}/inventory/{phoneId}": {
      "schema": {
        "$ref": "#/entities/PhoneInventoryItem"
      },
      "description": "Multi-tenant isolated phone inventory items"
    },
    "/users/{userId}/kyc_records/{kycId}": {
      "schema": {
        "$ref": "#/entities/KycRecord"
      },
      "description": "Multi-tenant isolated KYC and Shapath Patra records"
    },
    "/users/{userId}/dues/{dueId}": {
      "schema": {
        "$ref": "#/entities/DueRecord"
      },
      "description": "Multi-tenant isolated pending dues records"
    }
  }
}
