        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sellerMobile": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20
        },
        "sellerAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "idType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "idMasked": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "paymentMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "paidAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Ready", "Under repair", "Sold"]
        },
        "sourceType": {
          "type": "string",
          "enum": ["Customer", "Dealer"]
        },
        "buyerName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "buyerMobile": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "purchaseDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "daysInStock": {
          "type": "number"
        },
        "kycId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "stockCode",
        "noImeiDeadPhone",
        "imei",
        "brand",
        "model",
        "ram",
        "storage",
        "accessories",
