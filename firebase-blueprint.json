    "DueRecord": {
      "title": "DueRecord",
      "description": "Pending payment due record for customer or dealer transactions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "partyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "partyMobile": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20
        },
        "phoneModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "number"
        },
