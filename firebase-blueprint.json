{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Shop owner profile and multi-tenant configuration",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the shop owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Owner email address",
          "minLength": 3,
          "maxLength": 254
        },
        "shopName": {
          "type": "string",
          "description": "Display name of the mobile shop",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerName": {
          "type": "string",
          "description": "Full name of the shop owner",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Shop contact number",
          "minLength": 0,
          "maxLength": 20
        },
        "city": {
          "type": "string",
          "description": "Shop city and address",
          "minLength": 0,
          "maxLength": 200
        },
        "planStatus": {
          "type": "string",
          "description": "Subscription tier status",
          "enum": ["trial", "pro"],
          "minLength": 3,
          "maxLength": 20
        },
        "trialDaysLeft": {
          "type": "number",
          "description": "Remaining trial days"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "shopName",
        "ownerName",
        "planStatus",
        "trialDaysLeft",
        "createdAt",
        "updatedAt"
      ]
    },
    "PhoneInventoryItem": {
